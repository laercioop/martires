      "css": ".ds-search{display:block;position:relative}.ds-search svg{position:absolute;left:.7rem;top:.8rem;width:18px;height:18px;fill:none;stroke:var(--ink,#213b47);stroke-width:1.7}.ds-search input{font-family:var(--font,'Source Sans 3',sans-serif);color:var(--ink,#213b47);width:100%;min-width:0;box-sizing:border-box;font-size:1rem;padding:.65rem .5rem .65rem 2.5rem;background:#f0f5f7;border:1px solid var(--line,#d3dee3);border-radius:4px;caret-color:var(--accent,#933c50)}.ds-search input:focus-visible{outline:3px solid var(--accent,#933c50);outline-offset:4px}",
